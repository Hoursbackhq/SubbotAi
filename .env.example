# Copy to .env and fill in real values. Never commit the real .env file.

PORT=3747
DATA_DIR=                        # defaults to ~/.hermes if unset

# LLM (Nous Research / OpenAI-compatible) — used by llm-analyze.py, negotiate.py
OPENAI_API_KEY=
OPENAI_BASE_URL=https://inference-api.nousresearch.com/v1

# Celo contracts
AGENT_PRIVATE_KEY=               # Celo wallet private key that owns the contracts below
LOG_CONTRACT_ADDRESS=
CREDITS_CONTRACT_ADDRESS=

# Auth — generate long random strings, e.g. `openssl rand -hex 32`
SESSION_SECRET=                  # signs user session tokens (api-bridge.js)
INTERNAL_SERVICE_TOKEN=          # shared secret for negotiate.py / llm-analyze.py calling /log-decision

# Telemetry dashboard
TELEMETRY_KEY=                   # required to read GET /telemetry/stats

# Bills (VTpass) — keys from https://www.vtpass.com/profile/api-keys
# VTPASS_ENV is "sandbox" (default) or "live"
VTPASS_ENV=sandbox
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=
# Celo address that receives users' G$ for bills (swapped to cUSD by scripts/treasury-swap.js)
BILLS_TREASURY_ADDRESS=
# Fee on top of the bill, in basis points (300 = 3%)
BILLS_MARGIN_BPS=300
# Optional fixed G$ price in naira; unset = live CoinGecko price
GD_NGN_PRICE=
# "off" skips the on-chain G$ check — only honoured while VTPASS_ENV=sandbox, for demos
BILLS_CHAIN_CHECK=on
# Bill jars work without a contract: G$ stays in the user's wallet and autopay pulls
# it with an ERC-20 approval to the AGENT_PRIVATE_KEY wallet (needs CELO for gas).
# Run POST /jars/run-due (x-internal-token) daily to pay due jars.
# Optional: SubBotJars contract address, to hold G$ in on-chain jars instead
JARS_CONTRACT_ADDRESS=
# scripts/treasury-swap.js (batch G$ → cUSD)
TREASURY_PRIVATE_KEY=
# UniswapV2-compatible router with a G$→cUSD route on Celo
SWAP_ROUTER=
SWAP_MAX_SLIPPAGE_BPS=100
